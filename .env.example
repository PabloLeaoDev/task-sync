# Application
NODE_ENV=development
PORT=3000

# JWT & OAuth 2.0
JWT_ACCESS_SECRET=change_me_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Optional: redirect the OAuth callback to the frontend with tokens in the query
OAUTH_SUCCESS_REDIRECT_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# RabbitMQ
RABBITMQ_URL=amqp://admin:adminpassword@localhost:5672

# Primary Database (PostgreSQL)
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/tasksync
DATABASE_SSL=false
